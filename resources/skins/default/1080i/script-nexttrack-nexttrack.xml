<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Standalone Next Track overlay — the shared top-right next-item card: square album
    art at the right edge, and beside it three right-aligned lines (countdown header,
    title, artist • album), mirroring Arctic Fuse 3's Object_NextItem layout.
    Shown as a non-blocking, non-interactive overlay on skins without a native Next Track overlay.
    Position: top-right corner (right:80, top:60).
-->
<window type="dialog">
    <onload>Dialog.Close(fullscreeninfo,true)</onload>
    <controls>
        <control type="group">
            <right>80</right>
            <top>60</top>
            <width>870</width>
            <height>230</height>
            <!-- Slide in from the right on show -->
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="300" />
                <effect type="slide" start="48,0" end="0,0" tween="back" easing="out" time="400" />
            </animation>
            <!-- Fade out on close -->
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="200" />
                <effect type="slide" start="0,0" end="48,0" tween="cubic" easing="in" time="220" />
            </animation>

            <!-- Square album art at the right edge -->
            <control type="image">
                <right>0</right>
                <top>0</top>
                <width>230</width>
                <height>230</height>
                <aspectratio>scale</aspectratio>
                <texture background="true">$INFO[Window.Property(thumb)]</texture>
                <visible>!String.IsEmpty(Window.Property(thumb))</visible>
            </control>

            <!-- Text lines, right-aligned to the left of the art -->
            <control type="grouplist">
                <right>230</right>
                <top>0</top>
                <width>640</width>
                <height>230</height>
                <orientation>vertical</orientation>
                <itemgap>0</itemgap>
                <aligny>center</aligny>

                <!-- "Up next in 12s" — small, dimmer -->
                <control type="label">
                    <left>0</left>
                    <width>600</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>7fededed</textcolor>
                    <shadowcolor>99000000</shadowcolor>
                    <align>right</align>
                    <label>$ADDON[service.nexttrack 30050]$INFO[Window.Property(remaining), in ,s]</label>
                </control>

                <!-- Track title -->
                <control type="label">
                    <left>0</left>
                    <width>600</width>
                    <height>40</height>
                    <font>font13</font>
                    <textcolor>e7ededed</textcolor>
                    <shadowcolor>99000000</shadowcolor>
                    <align>right</align>
                    <label>$INFO[Window.Property(title)]</label>
                </control>

                <!-- Artist • album -->
                <control type="label">
                    <left>0</left>
                    <width>600</width>
                    <height>40</height>
                    <font>font12</font>
                    <textcolor>b3ededed</textcolor>
                    <shadowcolor>99000000</shadowcolor>
                    <align>right</align>
                    <label>$INFO[Window.Property(artist)]$INFO[Window.Property(album), [COLOR=4dededed]•[/COLOR] ,]</label>
                </control>
            </control>
        </control>
    </controls>
</window>
